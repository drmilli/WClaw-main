# WeatherClaw cron schedule
# scan: every 30 minutes (12 API calls x 48 runs/day = 576/day, well under 10K limit)
*/30 * * * * cd /app && bun run src/commands/scan.ts >> /app/data/cron.log 2>&1
# settle: every hour
0 * * * * cd /app && bun run src/commands/settle.ts >> /app/data/cron.log 2>&1
# status: 8 AM daily
0 8 * * * cd /app && bun run src/commands/status.ts >> /app/data/cron.log 2>&1
